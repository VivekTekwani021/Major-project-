# ============================================================
# BharatRoad Twin - Environment Configuration
# Copy this file to .env and adjust values as needed.
# ============================================================

# --- General ---
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/bharatroad.db

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# --- SUMO ---
# Set this to your SUMO installation directory
# Windows default: C:\Program Files (x86)\Eclipse\Sumo
# Linux default: /usr/share/sumo
SUMO_HOME=

# --- ML Model ---
# Path to pretrained YOLOv8 model weights (leave empty for demo mode)
YOLO_MODEL_PATH=
# Confidence threshold for detections
YOLO_CONFIDENCE=0.25

# --- Demo Mode ---
# Set to true to use bundled demo data instead of live computation
DEMO_MODE=true

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_TYPES=.mp4,.avi,.mov,.mkv

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
