<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  BharatRoad Twin - Indian Traffic Vehicle Types Definition
  ===========================================================
  Defines realistic physical and dynamic properties of vehicles operating on Indian roads,
  including sublane model parameters for weak lane discipline (latAlignment, minGapLat, etc.)
-->
<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">

    <!-- 1. Two-Wheeler (Motorcycle / Scooter) -->
    <!-- High lateral agility, narrow width, eager overtaking, sublane filtering -->
    <vType id="two_wheeler" 
           vClass="motorcycle" 
           length="1.80" 
           width="0.80" 
           height="1.20" 
           minGap="0.8" 
           maxSpeed="16.67" 
           accel="3.5" 
           decel="4.5" 
           sigma="0.8" 
           color="0.9,0.1,0.1" 
           latAlignment="arbitrary" 
           minGapLat="0.30" 
           maxSpeedLat="1.5" 
           lcSublane="1.0" 
           lcPushy="0.8" 
           lcAssertive="1.5" />

    <!-- 2. Auto-Rickshaw (3-Wheeler) -->
    <!-- Moderate speed, compact width, frequent stopping/weaving -->
    <vType id="auto_rickshaw" 
           vClass="autorickshaw" 
           length="2.60" 
           width="1.30" 
           height="1.70" 
           minGap="1.0" 
           maxSpeed="12.50" 
           accel="2.0" 
           decel="3.5" 
           sigma="0.7" 
           color="0.9,0.8,0.1" 
           latAlignment="right" 
           minGapLat="0.40" 
           maxSpeedLat="1.0" 
           lcSublane="0.8" 
           lcPushy="0.6" 
           lcAssertive="1.2" />

    <!-- 3. Standard Passenger Car (Hatchback / Sedan / SUV) -->
    <vType id="car" 
           vClass="passenger" 
           length="4.20" 
           width="1.80" 
           height="1.50" 
           minGap="1.5" 
           maxSpeed="22.22" 
           accel="2.6" 
           decel="4.5" 
           sigma="0.5" 
           color="0.2,0.4,0.9" 
           latAlignment="center" 
           minGapLat="0.60" 
           maxSpeedLat="0.8" 
           lcSublane="0.5" 
           lcPushy="0.3" 
           lcAssertive="1.0" />

    <!-- 4. City Bus (Public Transport) -->
    <!-- Large, slow acceleration, occupies substantial lateral width -->
    <vType id="bus" 
           vClass="bus" 
           length="10.50" 
           width="2.50" 
           height="3.20" 
           minGap="2.5" 
           maxSpeed="13.89" 
           accel="1.2" 
           decel="3.0" 
           sigma="0.3" 
           color="0.1,0.7,0.3" 
           latAlignment="center" 
           minGapLat="0.80" 
           maxSpeedLat="0.4" 
           lcSublane="0.2" 
           lcPushy="0.2" 
           lcAssertive="0.8" />

    <!-- 5. Light Commercial Vehicle (LCV / Pickup Truck) -->
    <vType id="lcv" 
           vClass="delivery" 
           length="5.50" 
           width="2.00" 
           height="2.20" 
           minGap="2.0" 
           maxSpeed="16.67" 
           accel="1.8" 
           decel="3.5" 
           sigma="0.4" 
           color="0.6,0.3,0.8" 
           latAlignment="center" 
           minGapLat="0.70" 
           maxSpeedLat="0.6" 
           lcSublane="0.4" 
           lcPushy="0.3" 
           lcAssertive="0.9" />

    <!-- 6. Heavy Goods Vehicle (Truck / Tipper) -->
    <vType id="truck" 
           vClass="truck" 
           length="9.00" 
           width="2.50" 
           height="3.50" 
           minGap="3.0" 
           maxSpeed="11.11" 
           accel="1.0" 
           decel="2.5" 
           sigma="0.2" 
           color="0.4,0.4,0.4" 
           latAlignment="center" 
           minGapLat="0.90" 
           maxSpeedLat="0.3" 
           lcSublane="0.1" 
           lcPushy="0.1" 
           lcAssertive="0.5" />

</additional>
